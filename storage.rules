rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /churches/{churchId}/posts/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    // Regra geral para outros arquivos se houver
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
