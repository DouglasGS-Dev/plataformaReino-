rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ===============================================================
    // Assumed Data Model & PII Protection Policy
    // ===============================================================
    // 
    // This system implements a strict Multi-tenant isolation.
    // PII (Email, Phone, Address) is NEVER exposed to other members.
    // Only Church Admins and the Owner can see sensitive data.
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isAdmin() {
      return isAuthenticated() &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
          (request.auth.token.email == "douglassousa95475@gmail.com" && request.auth.token.email_verified == true));
    }

    function isChurchAdmin(churchId) {
      return isAuthenticated() && 
             (isAdmin() || 
              (exists(/databases/$(database)/documents/churches/$(churchId)) &&
               get(/databases/$(database)/documents/churches/$(churchId)).data.ownerId == request.auth.uid) ||
              (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
               get(/databases/$(database)/documents/users/$(request.auth.uid)).data.churchId == churchId &&
               get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'));
    }

    function isChurchMember(churchId) {
      return isAuthenticated() && 
             (isAdmin() || (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
              get(/databases/$(database)/documents/users/$(request.auth.uid)).data.churchId == churchId));
    }

    function isIntercessorAdmin(churchId) {
      return isAuthenticated() && 
             (isChurchAdmin(churchId) || 
              (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
               get(/databases/$(database)/documents/users/$(request.auth.uid)).data.churchId == churchId &&
               (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['pastor', 'leader'] ||
                ('tags' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data && 'intercessor' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.tags))));
    }

    function isCellMember(cellId) {
      return isAuthenticated() && 
             (isAdmin() || 
              (exists(/databases/$(database)/documents/cells/$(cellId)) && 
               request.auth.uid in get(/databases/$(database)/documents/cells/$(cellId)).data.members));
    }

    function isValidString(val, maxLen) {
      return val is string && val.size() <= maxLen;
    }

    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    // ===============================================================
    // Domain Validators
    // ===============================================================

    function isValidUser(data) {
      return hasOnlyAllowedFields(['uid', 'email', 'displayName', 'photoURL', 'role', 'churchId', 'createdAt']) &&
             data.uid == request.auth.uid &&
             data.role in ['user', 'pastor', 'leader', 'admin'] &&
             isValidString(data.displayName, 100);
    }

    function isValidPost(data) {
      return hasOnlyAllowedFields(['id', 'churchId', 'authorId', 'authorName', 'authorPhoto', 'content', 'type', 'likesCount', 'commentsCount', 'media', 'aspectRatio', 'createdAt']) &&
             isValidString(data.content, 5000) &&
             data.authorId == request.auth.uid;
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /users/{userId} {
      allow read: if isAuthenticated() && (isOwner(userId) || isChurchMember(resource.data.churchId));
      
      allow create: if isAuthenticated() && isOwner(userId) && isValidUser(request.resource.data);
                    
      allow update: if isAuthenticated() && (isOwner(userId) || isChurchAdmin(resource.data.churchId)) &&
                    (isOwner(userId) ? request.resource.data.role == resource.data.role : true) &&
                    isValidUser(request.resource.data);
    }

    match /churches/{churchId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isChurchAdmin(churchId);
    }

    match /posts/{postId} {
      allow read: if isChurchMember(resource.data.churchId);
      allow create: if isChurchMember(request.resource.data.churchId) && isValidPost(request.resource.data);
      allow update: if isAuthenticated() && (
        (isOwner(resource.data.authorId) || isChurchAdmin(resource.data.churchId)) ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likesCount', 'commentsCount']))
      );
      allow delete: if isOwner(resource.data.authorId) || isChurchAdmin(resource.data.churchId);
      
      match /likes/{userId} {
        allow read, write: if isOwner(userId);
      }
      
      match /comments/{commentId} {
        allow read: if isChurchMember(get(/databases/$(database)/documents/posts/$(postId)).data.churchId);
        allow create: if isChurchMember(get(/databases/$(database)/documents/posts/$(postId)).data.churchId) && request.resource.data.authorId == request.auth.uid;
        allow delete: if isOwner(resource.data.authorId) || isChurchAdmin(get(/databases/$(database)/documents/posts/$(postId)).data.churchId);
      }
    }

    match /prayer_requests/{requestId} {
      allow read: if isAuthenticated() && (
        (resource.data.isPrivate == false && isChurchMember(resource.data.churchId)) ||
        (resource.data.isPrivate == true && (isOwner(resource.data.authorId) || isChurchAdmin(resource.data.churchId)))
      );
      allow create: if isChurchMember(request.resource.data.churchId) && 
                    request.resource.data.authorId == request.auth.uid;
      allow update: if isOwner(resource.data.authorId) || isChurchAdmin(resource.data.churchId) ||
                    (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['intercessorsCount']));
      
      match /intercessions/{intercessionId} {
        allow read, write: if isAuthenticated() && (request.resource.data.intercessorId == request.auth.uid || isOwner(request.auth.uid));
      }
    }

    match /prayer_campaigns/{campaignId} {
      allow read: if isChurchMember(resource.data.churchId);
      allow create: if isIntercessorAdmin(request.resource.data.churchId);
      allow update: if isIntercessorAdmin(resource.data.churchId) ||
                    (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participantsCount']));
      allow delete: if isIntercessorAdmin(resource.data.churchId);

      match /participants/{participantId} {
        allow read, write: if isAuthenticated() && (request.resource.data.userId == request.auth.uid || isOwner(request.auth.uid));
      }
    }

    match /users/{userId}/entries/{entryId} {
      allow read, write: if isOwner(userId);
    }

    match /users/{userId}/stats/devotional {
      allow read, write: if isOwner(userId);
    }

    match /ministries/{ministryId} {
      allow read: if isChurchMember(resource.data.churchId);
      allow write: if isChurchAdmin(resource.data.churchId);
    }

    match /cells/{cellId} {
      allow read: if isChurchMember(resource.data.churchId);
      allow write: if isChurchAdmin(resource.data.churchId);
      
      match /messages/{messageId} {
        allow read: if isCellMember(cellId);
        allow create: if isCellMember(cellId) && request.resource.data.authorId == request.auth.uid;
      }
    }

    match /events/{eventId} {
      allow read: if resource.data.isPublic == true || isChurchMember(resource.data.churchId);
      allow write: if isChurchAdmin(resource.data.churchId);
    }

    match /finances/{transactionId} {
      allow read, write: if isChurchAdmin(resource.data.churchId);
    }

    match /schedules/{scheduleId} {
      allow read: if isChurchMember(resource.data.churchId);
      allow write: if isChurchAdmin(resource.data.churchId);
    }

    match /ebd_tracks/{trackId} {
      allow read: if isChurchMember(resource.data.churchId);
      allow write: if isChurchAdmin(resource.data.churchId);
    }

    match /ebd_enrollments/{enrollmentId} {
      allow read: if isOwner(resource.data.userId) || isChurchAdmin(resource.data.churchId);
      allow write: if isOwner(request.resource.data.userId) || isChurchAdmin(request.resource.data.churchId);
    }

    match /marketplace_items/{itemId} {
      allow read: if isChurchMember(resource.data.churchId);
      allow create: if isChurchMember(request.resource.data.churchId) && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if isOwner(resource.data.authorId) || isChurchAdmin(resource.data.churchId);
    }

    match /visitors/{visitorId} {
      allow read, write: if isChurchAdmin(resource.data.churchId);
    }
    
    // Default deny for everything else
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
